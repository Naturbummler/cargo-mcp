# Cargoboard credentials and API configuration
CARGOBOARD_API_KEY=replace-with-cargoboard-api-key
CARGOBOARD_BASE_URL=https://api.cargoboard.com
CARGOBOARD_TIMEOUT=30

# Railway provides PORT automatically. 8000 is useful for local testing.
PORT=8000

# Microsoft Entra app registration (single tenant only)
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-with-entra-client-secret-value
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_SCOPE=mcp.access
# Optional; defaults to api://<ENTRA_CLIENT_ID>
# ENTRA_IDENTIFIER_URI=api://00000000-0000-0000-0000-000000000000

# Public origin of this server. Railway can provide RAILWAY_PUBLIC_DOMAIN instead.
MCP_PUBLIC_BASE_URL=http://localhost:8000

# Restrict dynamically registered MCP clients. Production defaults to Claude.ai only.
# Local testing additionally permits loopback callbacks when this variable is omitted.
# MCP_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback

# Generate with: openssl rand -hex 32
OAUTH_JWT_SIGNING_KEY=replace-with-at-least-32-random-characters

# Local testing only. The server rejects memory storage for non-loopback URLs.
OAUTH_STORAGE_BACKEND=memory

# Railway production: set OAUTH_STORAGE_BACKEND=redis, attach Redis, and set both.
# REDIS_URL=redis://default:password@localhost:6379/0
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OAUTH_STORAGE_ENCRYPTION_KEY=replace-with-a-fernet-key

# Pilot default: create_order is not exposed. Set to true only after approval.
CARGOBOARD_ENABLE_WRITE_TOOLS=false
